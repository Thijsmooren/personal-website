# Set this in Vercel before publishing. Never commit the real password.
CLASSIQ_PASSWORD=choose-a-strong-password

# Frascati discovery form. Connect a Private Blob store in Vercel.
# Vercel adds BLOB_READ_WRITE_TOKEN automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=
# The respondent session and admin login use CLASSIQ_PASSWORD by default.
DISCOVERY_SESSION_SECRET=
DISCOVERY_ADMIN_PASSWORD=
